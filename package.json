{
  "name": "retrolash",
  "version": "0.4.0",
  "description": "A Quiplash-style party game for Scrum retrospectives: big screen + phones.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"tsx watch server/main.ts\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist-server/main.js",
    "typecheck": "tsc",
    "test": "tsx scripts/selftest.ts && npm run build && node scripts/e2e.mjs sv && node scripts/e2e.mjs en"
  },
  "dependencies": {
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
