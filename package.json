{
  "name": "retrolash",
  "version": "0.1.0",
  "description": "A Quiplash-style party game for Scrum retrospectives: big screen + phones.",
  "scripts": {
    "dev": "concurrently -k -n party,web -c magenta,cyan \"partykit dev\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc",
    "deploy": "vite build && partykit deploy"
  },
  "dependencies": {
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "partykit": "^0.0.115",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "type": "module"
}
